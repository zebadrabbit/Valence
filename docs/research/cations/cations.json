  "rules": [
    {
      "id": "chlorides-form",
      "says": "Hydrochloric acid brings silver, lead and mercury(I) ions out of a solution as solid chlorides. The model takes each of them to come down whole.",
      "sourceId": "malik-group-1-separation",
      "alsoSourceId": "smc-group-1-lab"
    },
    {
      "id": "lead-chloride-in-water",
      "says": "Lead chloride dissolves in water as far as its solubility allows, and hot water holds about three times as much of it as cold. Silver chloride and mercury(I) chloride stay solid in both.",
      "sourceId": "birk-lead",
      "alsoSourceId": "malik-group-1-ions"
    },
    {
      "id": "lead-chromate-forms",
      "says": "Lead ions and chromate ions form solid lead chromate.",
      "sourceId": "smc-group-1-lab",
      "alsoSourceId": "ntu-group-1-lab"
    },
    {
      "id": "silver-chloride-in-ammonia",
      "says": "Silver chloride dissolves in ammonia solution: the silver goes into the liquid as the silver-ammonia ion, and the chloride with it.",
      "sourceId": "birk-silver",
      "alsoSourceId": "smc-group-1-lab"
    },
    {
      "id": "mercury-chloride-with-ammonia",
      "says": "With ammonia solution, mercury(I) chloride does not dissolve. It turns into finely divided mercury and mercury(II) amidochloride, which stay as a solid.",
      "sourceId": "birk-mercury",
      "alsoSourceId": "malik-group-1-ions",
      "moreSourceIds": [
        "smc-group-1-lab"
      ]
    },
    {
      "id": "lead-chloride-with-ammonia",
      "says": "Lead chloride that is still with the solid when the ammonia goes in does not dissolve. A white solid is left, which a university laboratory handout gives as lead hydroxide.",
      "sourceId": "ntu-group-1-lab",
      "alsoSourceId": "birk-lead"
    },
    {
      "id": "silver-chloride-returns",
      "says": "Acid uses up the ammonia. Once the liquid is acid, the silver-ammonia ion is gone and the silver comes back out as silver chloride, with the chloride that was still dissolved.",
      "sourceId": "birk-silver",
      "alsoSourceId": "malik-group-1-ions",
      "moreSourceIds": [
        "smc-group-1-lab"
      ]
    },
    {
      "id": "litmus",
      "says": "In an acid liquid blue litmus paper goes red and red litmus paper keeps its colour. In a basic liquid red litmus paper goes blue and blue litmus paper keeps its colour.",
      "sourceId": "malik-ph-measurement",
      "alsoSourceId": "smc-group-1-lab"
    }
  ],
