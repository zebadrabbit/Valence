  "parameters": {
    "temperatureKelvin": {
      "value": 298.15,
      "rationale": "The temperature the table's Gibbs energies are for, 25 °C. Each solubility product and the formation constant are worked out at it, and used for a bench at room temperature."
    },
    "dropMicrolitres": {
      "value": 50,
      "rationale": "A drop from a dropper is taken as 0.05 mL, twenty to the millilitre: the figure one of the pages read gives for its own samples, and the one the titration lab stores. Every amount on this bench is a count of drops."
    },
    "sampleDropsOfEach": {
      "value": 10,
      "rationale": "A sample holds 10 drops, 0.5 mL, of the 0.1 M solution of each ion it is made from: 50 micromoles of each ion. It is the same for every ion and every sample, so the amount of an ion never depends on what else is there."
    },
    "sampleDrops": {
      "value": 30,
      "rationale": "Every sample is made up to 30 drops, 1.5 mL, with distilled water. The known needs no water; an unknown with one ion has 20 drops of it. So a sample's volume says nothing of how many ions it holds, and each ion is about 0.033 M."
    },
    "hydrochloricAcidDrops": {
      "value": 4,
      "rationale": "Four drops of the 6 M acid: 1.2 millimoles of chloride, nearly five times what the three ions together can take up. The pages read use two to four drops on a smaller sample. The build checks that it is enough to bring each chloride down, and one page read warns that a very large excess dissolves silver chloride again."
    },
    "waterDrops": {
      "value": 15,
      "rationale": "Fifteen drops, 0.75 mL, of distilled water at step 2. Chosen between the two limits the build checks: hot, it can hold nearly twice the lead chloride there is; cold, only about half. The pages read use more water, and then wash the solid again."
    },
    "aceticAcidDrops": {
      "value": 1,
      "rationale": "One drop of the 6 M acid before the chromate, as both procedures read have it. It adds its volume to the tube and takes no other part in the model."
    },
    "chromateDrops": {
      "value": 4,
      "rationale": "Four drops of the 0.5 M solution: 100 micromoles of chromate, twice the lead a sample can hold. So some chromate is always left over, and the liquid is coloured whether lead is there or not. The build checks both."
    },
    "ammoniaDrops": {
      "value": 15,
      "rationale": "Fifteen drops, 0.75 mL, of the 6 M solution: 4.5 millimoles of ammonia. One procedure read uses ten to twelve drops and another two millilitres. The build checks that this much can hold all the silver chloride in solution."
    },
    "nitricAcidDrops": {
      "value": 8,
      "rationale": "One addition of nitric acid is eight drops of the 6 M acid: 2.4 millimoles. One addition leaves ammonia over and two do not, whatever the sample holds, so the liquid has to be tested between additions. The build checks that, and that the ammonia left after one addition still holds the silver in solution."
    },
    "nitricAcidAdditions": {
      "value": 4,
      "rationale": "The most additions of nitric acid the third tube takes. Two make the liquid acid; two more are room for a learner who goes on adding. After that the tube is taken to be full."
    },
    "completeWithinPercent": {
      "value": 1,
      "rationale": "The model takes a chloride to come down whole at step 1. The build checks that the part its solubility product leaves dissolved, at the chloride left in the tube, is under this share of what went in. That sum counts free ions only; a real tube keeps more lead dissolved than it says."
    }
  }
