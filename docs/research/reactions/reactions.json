      "vessels": [
        {
          "id": "tube",
          "drawn": "tube",
          "liquid": {
            "value": "blue",
            "sourceId": "microscale-observing-chemical-changes",
            "start": "tubeMicrolitres",
            "added": null
          },
          "metal": {
            "id": "zinc",
            "reagentId": "zinc-pieces",
            "colour": {
              "value": "grey",
              "sourceId": "birk-zinc"
            }
          },
          "asks": [
            "coating",
            "liquid"
          ],
          "after": {
            "coating": {
              "value": "red-brown",
              "sourceId": "microscale-observing-chemical-changes"
            },
            "liquid": {
              "value": "paler blue",
              "sourceId": "microscale-observing-chemical-changes"
            }
          },
          "looks": [
            {
              "at": "metal",
              "before": "A grey piece of metal lies beside the tube.",
              "after": "A red-brown coating covers the metal."
            },
            {
              "at": "liquid",
              "before": "The liquid is clear and blue.",
              "after": "The liquid is still clear, and a paler blue than it was."
            }
          ],
          "kind": {
            "value": "single-replacement",
            "sourceId": "microscale-observing-chemical-changes",
            "alsoSourceId": "soult-types-of-inorganic-reactions"
          },
          "equation": {
            "reactants": [
              {
                "speciesId": "zinc",
                "coefficient": 1
              },
              {
                "speciesId": "copper-ii-sulfate",
                "coefficient": 1
              }
            ],
            "products": [
              {
                "speciesId": "zinc-sulfate",
                "coefficient": 1
              },
              {
                "speciesId": "copper",
                "coefficient": 1
              }
            ],
            "sourceId": "chemguide-metal-salt-displacement",
            "alsoSourceId": "chemguide-metals-dilute-acids"
          }
        }
      ],
      "order": false,
      "notes": [
        {
          "value": "The red-brown coating is copper metal. Zinc took the place of copper in the dissolved copper(II) sulfate, and the copper came out as a solid on the zinc.",
          "sourceId": "microscale-observing-chemical-changes"
        },
        {
          "value": "The blue belongs to the dissolved copper(II) sulfate, so it fades as that is used up. The zinc sulfate made in its place has no colour in water.",
          "sourceId": "chemguide-metal-salt-displacement",
          "alsoSourceId": "chemguide-metals-dilute-acids"
        },
        {
          "value": "One element took the place of another in a compound: a single replacement. Zinc can push copper out because it is the more active of the two.",
          "sourceId": "chemguide-metal-salt-displacement",
          "alsoSourceId": "chemguide-reactivity-series"
        }
      ]
    },
