    {
      "id": "zinc-copper-sulfate",
      "letter": "A",
      "title": "Zinc in copper(II) sulfate solution",
      "action": "put-in",
      "reagentIds": [
        "zinc-pieces",
        "cuso4-1m"
      ],
      "tiles": [
        "zinc",
        "copper-ii-sulfate",
